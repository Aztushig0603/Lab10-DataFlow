digraph bonus_cfg {
  graph [rankdir=TB, splines=polyline, nodesep=0.45, ranksep=0.62, fontname="Arial", labelloc="t", label="CFG — DataFlowTargets.bonus()", fontsize=18];
  node [shape=box, style="rounded", fontname="Arial", fontsize=9, margin="0.12,0.08"];
  edge [fontname="Arial", fontsize=6, arrowsize=0.65];
  entry [shape=oval,label="Entry"];
  check [label="32: attendance == null || threshold < 0?"];
  bad [label="throw IllegalArgumentException"];
  init [label="35: present=0\n36: streak=0\n37: best=0"];
  loop [label="38: attendance-д дараагийн элемент байна уу?\nT: a-д дараагийн элементийг оноох (a def)\nF: давталт дуусах"];
  acheck [label="39: a > 0 ?"];
  inc [label="40: present = present + 1\n41: streak = streak + 1"];
  bestcheck [label="42: streak > best ?"];
  update [label="43: best = streak"];
  reset [label="46: streak = 0"];
  score0 [label="49: score = 0"];
  presentcheck [label="50: present >= threshold ?"];
  score5 [label="51: score = 5"];
  best5 [label="53: best >= 5 ?"];
  scoreplus [label="54: score = score + 3"];
  ret [label="56: return score",shape=oval];
  entry -> check;
  check -> bad [label="T: duPairs_10_null_attendance_throws; duPairs_11_negative_threshold_throws"];
  check -> init [label="F: allDefs_01_reset_streak_and_score_zero_definition"];
  init -> loop;
  loop -> acheck [label="T: allDefs_01_reset_streak_and_score_zero_definition; allDefs_02_five_consecutive_days_score_five_then_eight"];
  loop -> score0 [label="F: duPairs_03_empty_array_threshold_zero_present_true_best_false"];
  acheck -> inc [label="T: allDefs_01_reset_streak_and_score_zero_definition; allDefs_02_five_consecutive_days_score_five_then_eight"];
  acheck -> reset [label="F: allDefs_01_reset_streak_and_score_zero_definition; duPairs_04_all_absent_threshold_positive_present_false"];
  inc -> bestcheck;
  bestcheck -> update [label="T: allDefs_02_five_consecutive_days_score_five_then_eight"];
  bestcheck -> loop [label="F: duPairs_09_streak_comparison_false_after_shorter_streak", minlen=2];
  update -> loop [label="next: allDefs_02_five_consecutive_days_score_five_then_eight; duPairs_07_total_present_exceeds_best_streak_kills_wrong_best_update"];
  reset -> loop [label="next: allDefs_01_reset_streak_and_score_zero_definition; duPairs_06_streak_five_after_reset_kills_old_streak_definition"];
  score0 -> presentcheck;
  presentcheck -> score5 [label="T: duPairs_03_empty_array_threshold_zero_present_true_best_false; duPairs_05_exact_present_threshold_and_short_streak"];
  presentcheck -> best5 [label="F: allDefs_01_reset_streak_and_score_zero_definition; duPairs_08_best_streak_five_but_present_below_threshold_score_three"];
  score5 -> best5;
  best5 -> scoreplus [label="T: allDefs_02_five_consecutive_days_score_five_then_eight; duPairs_08_best_streak_five_but_present_below_threshold_score_three"];
  best5 -> ret [label="F: duPairs_05_exact_present_threshold_and_short_streak"];
  scoreplus -> ret;
}
